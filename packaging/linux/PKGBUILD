# Maintainer: OpenScreen Contributors <https://github.com/getopenscreen/openscreen>
pkgname=openscreen
pkgver=1.0.0
pkgrel=1
pkgdesc="High-Performance Screen Recorder & Native Video Editor written in Zig"
arch=('x86_64' 'aarch64')
url="https://github.com/getopenscreen/openscreen"
license=('MIT' 'LGPL2.1')
depends=('libx11' 'libxext' 'libxfixes' 'libxi' 'libpulse' 'alsa-lib' 'ffmpeg' 'pipewire')
makedepends=('zig>=0.17.0')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    zig build -Doptimize=ReleaseFast
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 "zig-out/bin/openscreen" "$pkgdir/usr/bin/openscreen"
    install -Dm644 "packaging/linux/openscreen.desktop" "$pkgdir/usr/share/applications/openscreen.desktop"
    install -Dm644 "assets/openscreen.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/openscreen.png"
    
    mkdir -p "$pkgdir/usr/share/openscreen"
    cp -r assets "$pkgdir/usr/share/openscreen/"

    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 THIRD-PARTY-NOTICES.md "$pkgdir/usr/share/doc/$pkgname/THIRD-PARTY-NOTICES.md"
}
